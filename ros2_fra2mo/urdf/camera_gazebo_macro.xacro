<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rgb_camera_gazebo_sensor" params="parent">
    
    <!-- Standard RGB Camera Sensor for Gazebo -->
    <gazebo reference="${parent}">
      <sensor name="rover_camera" type="camera">
        <!-- Orientamento: punta in avanti -->
        <pose>0.05 0 0.15 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>30.0</update_rate>
        <topic>/rover/camera/image_raw</topic>
        
        <!-- IGNITION CAMERA CONFIGURATION -->
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- Circa 80 gradi -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
