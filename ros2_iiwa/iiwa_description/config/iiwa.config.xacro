<?xml version="1.0"?>
<!-- Kuka iiwa 7DoF manipulator -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">

    <!-- Enable setting arguments from the launch file -->
    <xacro:arg name="use_sim" default="false" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="prefix" default="" />
    <xacro:arg name="robot_ip" default="192.170.10.2" />
    <xacro:arg name="robot_port" default="30200" />
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="command_interface" default="position" />
    <xacro:arg name="base_frame_file" default="base_frame.yaml" />
    <xacro:arg name="description_package" default="iiwa_description" />
    <xacro:arg name="runtime_config_package" default="iiwa_description" />
    <xacro:arg name="controllers_file" default="iiwa_controllers.yaml" />
    <xacro:arg name="robot_name" default="iiwaRobot" />
    <xacro:arg name="namespace" default="/" />

    <xacro:property name="description_package" value="$(arg description_package)"/>

    <!-- Import iiwa urdf file -->
    <xacro:include filename="$(find ${description_package})/urdf/iiwa.urdf.xacro" />

    <!-- Import iiwa ros2_control description -->
    <xacro:include filename="$(find ${description_package})/ros2_control/iiwa.r2c_hardware.xacro" />

    <!-- Import all Gazebo-customization elements -->
    <xacro:include filename="$(find ${description_package})/gazebo/iiwa.gazebo.xacro"/>

    <!-- Used for fixing robot -->
    <link name="world"/>
    <gazebo reference="world">
        <static>true</static>
    </gazebo>

    <xacro:property name="base_frame_file" value="$(arg base_frame_file)"/>
    <xacro:property name="base_frame" value="${xacro.load_yaml(base_frame_file)['base_frame']}"/>

    <xacro:iiwa parent="world" prefix="$(arg prefix)">
        <origin xyz="${base_frame['x']} ${base_frame['y']} ${base_frame['z']}"
            rpy="${base_frame['roll']} ${base_frame['pitch']} ${base_frame['yaw']}" />
    </xacro:iiwa>

    <xacro:iiwa_r2c_hardware
        name="$(arg robot_name)" 
        prefix="$(arg prefix)"
        robot_ip="$(arg robot_ip)" 
        robot_port="$(arg robot_port)"
        command_interface="$(arg command_interface)"
        initial_positions_file="$(arg initial_positions_file)"
        use_sim="$(arg use_sim)" 
        use_fake_hardware="$(arg use_fake_hardware)"
        />

    <xacro:iiwa_gazebo
        runtime_config_package="$(arg runtime_config_package)"
        controllers_file="$(arg controllers_file)"
        namespace="$(arg namespace)"
        prefix="$(arg prefix)"
        />


    <!-- ================================================================
         DETACHABLE JOINTS per gli strumenti chirurgici.
       ================================================================ -->

    <!-- ================================================================
         DETACHABLE JOINTS per gli strumenti chirurgici.
       ================================================================ -->

    <!-- ================================================================
         DETACHABLE JOINTS per gli strumenti chirurgici (IIWA1)
       ================================================================ -->
    <xacro:if value="${'$(arg prefix)' == 'iiwa1_'}">
    <gazebo>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa1_link_7</parent_link>
            <child_model>scalpel</child_model>
            <child_model_link>corpo_bisturi</child_model_link>
            <child_link>corpo_bisturi</child_link>
            <detach_topic>/iiwa1/picker/scalpel/detach</detach_topic>
            <attach_topic>/iiwa1/picker/scalpel/attach</attach_topic>
        </plugin>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa1_link_7</parent_link>
            <child_model>forceps</child_model>
            <child_model_link>corpo_pinza</child_model_link>
            <child_link>corpo_pinza</child_link>
            <detach_topic>/iiwa1/picker/forceps/detach</detach_topic>
            <attach_topic>/iiwa1/picker/forceps/attach</attach_topic>
        </plugin>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa1_link_7</parent_link>
            <child_model>scissors</child_model>
            <child_model_link>corpo_forbici</child_model_link>
            <child_link>corpo_forbici</child_link>
            <detach_topic>/iiwa1/picker/scissors/detach</detach_topic>
            <attach_topic>/iiwa1/picker/scissors/attach</attach_topic>
        </plugin>
    </gazebo>
    </xacro:if>

    <!-- ================================================================
         DETACHABLE JOINTS per gli strumenti chirurgici (IIWA2)
       ================================================================ -->
    <xacro:if value="${'$(arg prefix)' == 'iiwa2_'}">
    <gazebo>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa2_link_7</parent_link>
            <child_model>scalpel</child_model>
            <child_model_link>corpo_bisturi</child_model_link>
            <child_link>corpo_bisturi</child_link>
            <detach_topic>/iiwa2/picker/scalpel/detach</detach_topic>
            <attach_topic>/iiwa2/picker/scalpel/attach</attach_topic>
        </plugin>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa2_link_7</parent_link>
            <child_model>forceps</child_model>
            <child_model_link>corpo_pinza</child_model_link>
            <child_link>corpo_pinza</child_link>
            <detach_topic>/iiwa2/picker/forceps/detach</detach_topic>
            <attach_topic>/iiwa2/picker/forceps/attach</attach_topic>
        </plugin>
        <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
            <parent_link>iiwa2_link_7</parent_link>
            <child_model>scissors</child_model>
            <child_model_link>corpo_forbici</child_model_link>
            <child_link>corpo_forbici</child_link>
            <detach_topic>/iiwa2/picker/scissors/detach</detach_topic>
            <attach_topic>/iiwa2/picker/scissors/attach</attach_topic>
        </plugin>
    </gazebo>
    </xacro:if>

</robot>
