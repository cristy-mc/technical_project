<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="iiwa_gazebo" params="runtime_config_package controllers_file namespace prefix">

    <gazebo>
      <plugin filename="ign_ros2_control-system"
              name="ign_ros2_control::IgnitionROS2ControlPlugin">

        <xacro:if value="${namespace != '/'}">

          <ros>
            <namespace>${namespace}</namespace>
          </ros>

          <robot_param_node>
            robot_state_publisher
          </robot_param_node>

        </xacro:if>

        <parameters>
          $(find ${runtime_config_package})/config/${controllers_file}
        </parameters>
        
        <position_proportional_gain>5.0</position_proportional_gain>

      </plugin>
    </gazebo>


    <gazebo reference="${prefix}link_7">
      <material>Gazebo/Gray</material>
    </gazebo>
    
        <!-- Sensore camera (Gazebo Sim) -->
    <gazebo reference="${prefix}camera_ee_link">
      <sensor name="${prefix}camera_ee" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
         <topic>${prefix}camera_ee</topic>
      </sensor>
    </gazebo>


  </xacro:macro>



</robot>
